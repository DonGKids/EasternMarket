# =============================================================================
# Eastern Market 环境变量模板(可安全提交到版本库)
# 使用方法:复制本文件为 .env 并填入真实值
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# =============================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-to-a-real-password
MYSQL_DATABASE=eastern_market

# ---- 支付宝沙箱(供 shop-order 服务使用)----
# 沙箱地址:https://open.alipay.com/develop/sandbox/app
# 在沙箱页面获取 AppID、应用私钥、支付宝公钥,填入下方对应项
ALIPAY_APP_ID=your-sandbox-app-id
ALIPAY_PRIVATE_KEY=your-app-private-key
ALIPAY_PUBLIC_KEY=alipay-public-key
# 异步通知地址:需公网可访问(本地开发用内网穿透工具如 cpolar/ngrok 暴露 7074 端口)
ALIPAY_NOTIFY_URL=http://your-tunnel-domain/shop/order/notify
# 同步跳转地址:支付完成后浏览器跳回前端页面(与 vite.config.js server.port 保持一致)
ALIPAY_RETURN_URL=http://localhost:1160/pay-result

# ---- QQ 邮箱(shop-user 发送验证码用)----
# QQ 邮箱授权码:QQ 邮箱 -> 设置 -> 账户 -> POP3/SMTP 服务 -> 开启并获取授权码
MAIL_USERNAME=your-qq-number@qq.com
MAIL_PASSWORD=your-qq-email-authorization-code

# ---- 七牛云对象存储(shop-user / shop-product 用)----
# 获取:七牛云控制台 -> 密钥管理(AK/SK) + 对象存储 -> 新建空间(bucket) + 绑定域名(domain)
QINIU_AK=your-qiniu-access-key
QINIU_SK=your-qiniu-secret-key
QINIU_BUCKET=your-bucket-name
QINIU_DOMAIN=http://your-qiniu-cdn-domain
